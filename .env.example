# Copy to .env and fill in. The config server reads this and serves the values to its
# clients, so a service no longer needs the credential in its own environment.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mcp
DB_USER=
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET_KEY=


# Shared secret between mcp-gateway and mcp-cipher.
MCP_CIPHER_TOKEN=

# RabbitMQ, between the planner and mcp-action.
QUEUE_HOST=127.0.0.1
QUEUE_PORT=5672
QUEUE_USER=
QUEUE_PASSWORD=
